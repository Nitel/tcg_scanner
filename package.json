{
  "name": "tcg-scanner",
  "private": true,
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "npm run start -w app",
    "build": "npm run build -w app",
    "test": "npm run test -w app",
    "test:watch": "npm run test:watch -w app",
    "lint": "npm run lint -w app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:sync": "npm run android:sync -w app",
    "android:open": "npm run android:open -w app",
    "android:run": "npm run android:run -w app",
    "eval:assets": "node tools/benchmark/copy-ocr-assets.mjs",
    "eval:score": "node tools/benchmark/score.ts",
    "eval:pull": "mkdir -p eval/captures && adb pull /sdcard/Android/data/io.github.nitel.tcgscanner/files/eval/. eval/captures"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
